{% extends 'base.html.twig' %}

{% block body %}
    <h1>Dashboard Administrateur</h1>

    <h2>Créer un compte employé</h2>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary">Créer</button>
    {{ form_end(form) }}

    <h2>Liste des utilisateurs</h2>
    <form method="get">
        <input type="text" name="search" placeholder="Rechercher par email ou rôle..." value="{{ app.request.get('search') }}">
        <button type="submit">Rechercher</button>
    </form>

    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Rôles</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>
                    {% if 'ROLE_ADMIN' not in user.roles %}
                        <a href="{{ path('admin_delete_user', {id: user.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ce compte ?');">Supprimer</a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
