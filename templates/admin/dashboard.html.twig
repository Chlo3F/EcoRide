{% extends 'base.html.twig' %}
{% set show_navbar = false %}
{% block body %}
<a class="navbar-brand" href="{{ path('homepage') }}">
    <img src="{{ asset('images/logo.png') }}" alt="logo" class="logo">
    Ecoride
</a>
<div class="container content-wrapper">
    <h1 class="admin-title text-center mb-4">Dashboard Administrateur</h1>

    <div class="row">
        <!-- Formulaire à gauche -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h2 class="h5 mb-0">Créer un compte employé</h2>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_widget(form) }}
                        </div>
                        <button class="btn btn-blue w-100">Créer</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <!-- Tableau à droite -->
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h2 class="h5 mb-0">Liste des utilisateurs</h2>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3 align-items-center mb-3">
                        <div class="col-md-9">
                            <input type="text" name="search" class="form-control" placeholder="Rechercher par email ou rôle..." value="{{ app.request.get('search') }}">
                        </div>
                        <div class="col-md-3 text-end">
                            <button type="submit" class="btn btn-green w-100">Rechercher</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Email</th>
                                    <th>Rôles</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in users %}
                                    <tr>
                                        <td>{{ user.id }}</td>
                                        <td>{{ user.email }}</td>
                                        <td>{{ user.roles|join(', ') }}</td>
                                        <td>
                                            {% if 'ROLE_ADMIN' not in user.roles %}
                                                <a href="{{ path('admin_delete_user', {id: user.id}) }}"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Supprimer ce compte ?');">
                                                    Supprimer
                                                </a>
                                            {% else %}
                                                <span class="text-muted">Admin</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <div class="d-flex justify-content-center mt-4">
                            {{ knp_pagination_render(users) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}