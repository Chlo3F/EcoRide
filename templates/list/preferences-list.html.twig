<div class="preferences-list">
    {% for pref in preferences %}
        <div class="preference-card">
            <p>Fumeur : {{ pref.fumeur ? 'Oui' : 'Non' }}</p>
            <p>Musique : {{ pref.animaux ? 'Oui' : 'Non' }}</p>
        </div>
    {% else %}
        <p>Aucune préférence enregistrée</p>
    {% endfor %}
</div>