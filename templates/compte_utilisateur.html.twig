{% extends 'base.html.twig' %}
{% set show_navbar = false %}
{% block title %}Mon Compte - Ecoride{% endblock %}

{% block body %}
<a class="brand" href="{{ path('homepage') }}">
    <img src="{{ asset('images/logo.png') }}" alt="logo" class="logo">
</a>

    <a href="{{ path('app_logout') }}">Me déconnecter</a>

    <!-- Section Profil Utilisateur -->
    <section class="profil">
        <div class="profil-info">
            <!-- Avatar avec aperçu -->
            <label for="avatar-upload" class="avatar-label">
                <img id="avatar-preview" src="{{ asset('images/icon electrique.png') }}" alt="Avatar" class="avatar">
            </label>
            <input type="file" id="avatar-upload" accept="image/*" style="display: none;">

            <div>
                <h2>Bonjour {{ app.user.prenom }} !</h2>
                <p>⭐ 0/5 - 0 Avis</p>
            </div>
        </div>

        <div class="credits">
            <span>{{ app.user.credits }}</span>
            <p>Crédits</p>
        </div>
    </section>

    <div class="d-flex justify-content-center mb-3">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="type_utilisateur" id="conducteur" value="conducteur">
            <label class="form-check-label" for="conducteur">Conducteur</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="type_utilisateur" id="passager" value="passager">
            <label class="form-check-label" for="passager">Passager</label>
        </div>
    </div>

    {# Section conducteur #}
    <div id="formulaires-conducteur" class="formualire mt-4"style="display: none;">
    <div class="row g-4">
        <div class="col-md-6">
            {% include 'partials/_vehicule_form.html.twig' %}
        </div>
        <div class="col-md-6">
            {% include 'partials/_preferences_form.html.twig' %}
        </div>
        <div class="col-md-12">
            {% include 'partials/_trajet_form.html.twig' %}
        </div>
    </div>
</div>

    {# Section passager #}
<div id="passager-section" class="hidden mt-5">
    <div class="text-center">
        <div class="alert alert-info d-inline-block">
            Bienvenue passager ! Vous pourrez bientôt réserver un trajet.
        </div>
        <div class="mt-3 mb-5">
            <a href="{{ path('homepage') }}" class="btn btn-info">Chercher un covoiturage</a>
        </div>
    </div>
</div>


<script src="{{ asset('js/compte.js') }}"></script>



    {% endblock %}